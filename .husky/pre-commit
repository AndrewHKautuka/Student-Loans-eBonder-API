#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

## husky task runner examples -------------------
## Note : for local installation use 'dotnet' prefix. e.g. 'dotnet husky'

## run all tasks
#husky run

### run all tasks with group: 'group-name'
#husky run --group group-name

## run task with name: 'task-name'
#husky run --name task-name

## pass hook arguments to task
#husky run --args "$1" "$2"

## or put your custom commands -------------------
#echo 'Husky.Net is awesome!'

# Collect staged files (added/copied/modified/renamed), null-delimited for safety with spaces
staged=()
while IFS= read -r -d '' f; do
  case "$f" in
    *.cs|*.csproj|*.sln) staged+=("$f") ;;
  esac
done < <(git diff --cached -z --name-only --diff-filter=ACMR)

# If nothing relevant is staged, exit fast
if [ ${#staged[@]} -eq 0 ]; then
  exit 0
fi

# Run format once against only staged paths (faster than 3 separate subcommands)
# --verify-no-changes fails the commit if formatting would change files
dotnet format --no-restore --severity error --verify-no-changes --include "${staged[@]}"
